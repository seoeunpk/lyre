rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function friendshipId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    function isAcceptedFriend(ownerId, viewerId) {
      let fid = friendshipId(ownerId, viewerId);
      return exists(/databases/$(database)/documents/friendships/$(fid)) &&
        get(/databases/$(database)/documents/friendships/$(fid)).data.status == 'accepted';
    }

    function isSharedWith(ownerId, viewerId) {
      let sharingPath = /databases/$(database)/documents/users/$(ownerId)/settings/sharing;
      return exists(sharingPath) &&
        viewerId in get(sharingPath).data.perFriend &&
        isAcceptedFriend(ownerId, viewerId);
    }

    // name + friend code only; readable by any signed-in user
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/entries/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && isSharedWith(userId, request.auth.uid);
    }

    match /users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if settingId == 'sharing' && request.auth != null &&
        (resource == null || request.auth.uid in resource.data.perFriend);
    }

    // notes: owner-only, never shared
    match /users/{userId}/private/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /friendships/{friendshipId} {
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid in resource.data.users);

      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending';

      // only the non-requesting participant can accept
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.users &&
        resource.data.requestedBy != request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.requestedBy == resource.data.requestedBy &&
        request.resource.data.users == resource.data.users;

      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

  }
}
